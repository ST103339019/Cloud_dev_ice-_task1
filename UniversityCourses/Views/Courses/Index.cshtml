@model List<UniversityCourses.Models.Course>

@{
    ViewData["Title"] = "Courses";
}

<h1>Available Courses</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add New Course</a>
</p>

@if (Model.Count == 0)
{
    <p>No courses have been added yet.</p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Course Code</th>
                <th>Course Name</th>
                <th>Lecturer</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var course in Model)
            {
                <tr>
                    <td>@course.CourseCode</td>
                    <td>@course.CourseName</td>
                    <td>@course.Lecturer</td>

                    <td>
                        <a asp-action="Details"
                           asp-route-id="@course.RowKey">
                            Details
                        </a>

                        |

                        <a asp-action="Edit"
                           asp-route-id="@course.RowKey">
                            Edit
                        </a>

                        |

                        <a asp-action="Delete"
                           asp-route-id="@course.RowKey">
                            Delete
                        </a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}